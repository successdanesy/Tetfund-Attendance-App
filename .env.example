# Copy this file to .env.local and fill in your MongoDB Atlas connection string.
# In Vercel, add the same two variables under Project Settings > Environment Variables.

# Your Atlas connection string, e.g. mongodb+srv://user:pass@cluster.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name to use inside the cluster.
MONGODB_DB=tetfund
